    <main>
        <section>
            <h2>5. CONTACTO</h2>
            <p>
                Comunícate con nosotros para conocer
                nuestros productos y servicios.
            </p>
        </section>

        <section>
            <h2>Ubicación</h2>
            <p>Modalidad:Tienda online (sin local fisico) </p>
            <p>Ciudad de referencia: Cusco, Perú</p>
        </section>

        <section>
            <h2>Redes sociales</h2>
            <p>Síguenos en nuestras redes sociales:</p>

            <ul>
                <li>
                    <a href="#"
                       onclick="alert('Proximamente estaremos disponibles en Facebook.');return false;">
                        Facebook
                    </a>
                </li>

                <li>
                    <a href="#"
                    onclick="alert('Proximamente estaremos disponibles en Instagram.'); return false;">
                        Instagram
                    </a>
                </li>

                <li>
                    <a href="#"
                       onclick="alert('Proximamente estaremos disponibles en TikTok.');return false;">
                        TikTok
                    </a>
                </li>
            </ul>
        </section>

        <section>
            <h2>WhatsApp</h2>
            <p>
                Escríbenos por WhatsApp para realizar
                consultas sobre nuestros productos.
            </p>

            <p>
                Proximamente estraremos disponibles en WhatsApp.
            </p>

            
            <a href="#"
            onclick="alert('Proximamente estaremos disponibles en whatsApp.');
            return false;">
                Contactar por WhatsApp
            </a>
        </section>

        <section>
            <h2>Formulario de contacto</h2>
            <form onsubmit="alert('Gracias por contactarnos. Pronto respomderemos a tu mensaje.'); return false;">
                <p>
                    <label for="nombre">Nombre:</label>
                    <input type="text"
                           id="nombre"
                           name="nombre"
                           required>
                </p>

                <p>
                    <label for="correo">Correo electrónico:</label>
                    <input type="email"
                           id="correo"
                           name="correo"
                           required>
                </p>

                <p>
                    <label for="mensaje">Mensaje:</label>
                    <textarea id="mensaje"
                              name="mensaje"
                              rows="5"
                              required></textarea>
                </p>

                <button type="submit">Enviar</button>
            </form>
        </section>
    </main>

    <footer>
